load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_image_layer")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages()

js_binary(
    name = "bin",
    data = [":node_modules/acorn"],
    entry_point = "main.js",
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

# When built from the outer workspace (`bazel build @child_workspace//:layer`),
# node_modules files have f.owner.repo_name != "" → is_external=true.
# This causes tar to reference the dest path (a sandbox symlink) directly.
# On remote execution that symlink does not exist → ENOENT.
js_image_layer(
    name = "layer",
    binary = ":bin",
    platform = ":linux_amd64",
    root = "/app",
    visibility = ["//visibility:public"],
)
